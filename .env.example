# GitHub API token (optional — recommended to avoid rate limits)
GITHUB_TOKEN=

# Database (SQLite by default — no installation required)
DATABASE_URL=sqlite+aiosqlite:///./data/repo_lens.db

# Redis (optional — app runs fine without it, caching is skipped)
REDIS_URL=redis://localhost:6379/0

# Where downloaded repository source files are stored
REPOSITORY_STORAGE_PATH=./data/repositories

# Application
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
